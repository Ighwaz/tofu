###############################################################################
# Kopieren nach terraform.tfvars und anpassen.
#
# Die Werte hier sind auf die Node `procmox` (PVE 9.2) zugeschnitten und
# stammen aus dem Ansible-Repo (inventory/hosts.yml, group_vars/proxmox.yml).
# Was in variables.tf schon als Default steht, ist hier nur zur Erinnerung
# aufgefuehrt und kann weggelassen werden.
#
# Achtung: terraform.tfvars ist per .gitignore ausgeschlossen und landet
# NICHT im Repository. Zugangsdaten gehoeren genau hierhin, nicht in die
# *.example.
###############################################################################

proxmox_endpoint = "https://192.168.178.10:8006/"
node_name        = "procmox"

# procmox hat ein selbstsigniertes Zertifikat.
proxmox_insecure = true

# API-Token statt Passwort. Erzeugen auf dem Node:
#   pveum user add tofu@pve
#   pveum aclmod / -user tofu@pve -role PVEAdmin
#   pveum role add TofuDownload -privs "Sys.Modify"
#   pveum aclmod / -user tofu@pve -role TofuDownload
#   pveum user token add tofu@pve provider --privsep 0
#
# Die zweite Rolle ist noetig: PVEAdmin enthaelt kein Sys.Modify, und ohne das
# lehnt der download-url-Endpunkt den Image-Download mit HTTP 403 ab.
#
# Besser nicht hier eintragen, sondern als Umgebungsvariable setzen:
#   export TF_VAR_proxmox_api_token='tofu@pve!provider=xxxxxxxx-xxxx-...'
# proxmox_api_token = "tofu@pve!provider=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# SSH wird nur fuer den Upload der cloud-init-Snippets gebraucht (VMs).
# Fuer LXC-Container ist das nicht noetig.
proxmox_ssh_username = "root"
proxmox_ssh_agent    = true

# Unter Windows ist der SSH-Agent haeufig gar nicht aktiv. Dann stattdessen
# den Schluessel direkt angeben - Pfad mit Schraegstrichen, auch unter Windows,
# und ohne Passphrase, weil der Provider nicht danach fragen kann:
#   proxmox_ssh_agent            = false
#   proxmox_ssh_private_key_file = "C:/Users/deinname/.ssh/id_ed25519"
# proxmox_ssh_private_key_file = "~/.ssh/id_ed25519"

# Cloud-Images (Content-Type "iso") und LXC-Templates (Content-Type "vztmpl").
# Beide liegen auf `local`; dort ist auch "snippets" zu aktivieren.
# Alternative fuer Images: das NFS-Storage `ISO`.
image_datastore_id    = "local"
template_datastore_id = "local"

###############################################################################
# Vorgaben fuer alle VMs
###############################################################################

vm_defaults = {
  image        = "debian-13"
  datastore_id = "bigpool" # ZFS, traegt laut Ansible-Inventory fast alle Gaeste

  cpu_cores = 2
  memory    = 2048
  disk_size = 20

  # bigpool ist ZFS - das kann kein qcow2, also raw. Nur bei einer VM auf
  # Verzeichnis-Storage (local, NFS, CIFS) muss hier "qcow2" stehen.
  disk_file_format = "raw"

  # UEFI mit q35 und virtio-scsi-single, wie in der Arbeitsumgebung. Die
  # EFI-Disk legt das Modul bei bios = "ovmf" selbst an. Die Debian- und
  # Ubuntu-Cloud-Images booten beides; wenn eine VM nicht hochkommt, ist
  # bios = "seabios" + machine = null der Weg zurueck (ersetzt die VM).
  bios          = "ovmf"
  machine       = "q35"
  scsi_hardware = "virtio-scsi-single"

  # SSD-Emulation braucht ein scsi-Interface, nicht virtio.
  disk_interface = "scsi0"
  disk_ssd       = true

  # cpu,memory,network,disk,usb erlaubt das Aendern im laufenden Betrieb.
  hotplug = "cpu,memory,network,disk,usb"

  username = "tofu"
  ssh_public_keys = [
    # Oeffentlicher Schluessel deines Arbeitsplatzrechners.
    "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... tofa@laptop",
  ]

  # Snippets muessen auf dem Datastore aktiviert sein:
  #   Datacenter -> Storage -> local -> Edit -> Content -> "Snippets"
  cloud_init_snippet   = true
  snippet_datastore_id = "local"

  network_devices = [{ bridge = "vmbr0" }]

  # Das Netz arbeitet mit DHCP-Reservierungen (siehe Ansible-Inventory).
  ip_configs  = [{ ipv4_address = "dhcp" }]
  dns_servers = ["192.168.178.50"] # adguardCT (LXC 102)
  dns_domain  = "lab.home.arpa"
}

###############################################################################
# Vorgaben fuer alle LXC-Container
###############################################################################

lxc_defaults = {
  datastore_id = "bigpool"
  cpu_cores    = 2
  memory       = 512
  swap         = 512
  disk_size    = 8
  unprivileged = true

  ssh_public_keys = [
    "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... tofa@laptop",
  ]

  network_interfaces = [{ bridge = "vmbr0" }]
  ip_configs         = [{ ipv4_address = "dhcp" }]
  dns_servers        = ["192.168.178.50"]
  dns_domain         = "lab.home.arpa"
}

###############################################################################
# Die einzelnen VMs
#
# VMID-Vergabe: auf procmox sind 100-106, 110, 112, 114, 150, 203 und 209
# belegt oder reserviert (siehe Ansible-Inventory). Damit sich OpenTofu und
# die bestehenden Gaeste nicht in die Quere kommen, liegt alles, was von hier
# verwaltet wird, ab 500. vm_id weglassen geht auch - dann vergibt PVE selbst.
###############################################################################

vms = {
  # Debian 13 mit DHCP
  "tofu-debian" = {
    image     = "debian-13"
    vm_id     = 501
    cpu_cores = 2
    memory    = 2048
    disk_size = 20
    tags      = ["opentofu", "debian"]
  }

  # Zusatzplatte, die cloud-init beim ersten Boot selbst einrichtet:
  # formatieren, in die fstab eintragen, mounten. Kein mkfs per SSH.
  # "tofu-data" = {
  #   image     = "debian-13"
  #   vm_id     = 503
  #   disk_size = 20
  #
  #   extra_disks = [{
  #     interface  = "scsi1"
  #     size       = 100
  #     filesystem = "ext4"
  #     mount      = "/var/lib/data"
  #   }]
  # }

  # Ubuntu 24.04 mit fester IP ausserhalb des DHCP-Bereichs
  # "tofu-ubuntu" = {
  #   image     = "ubuntu-24.04"
  #   vm_id     = 502
  #   cpu_cores = 4
  #   memory    = 4096
  #   disk_size = 40
  #
  #   ip_configs = [{
  #     ipv4_address = "192.168.178.60/24"
  #     ipv4_gateway = "192.168.178.1"
  #   }]
  #
  #   packages        = ["qemu-guest-agent", "curl", "vim"]
  #   package_upgrade = true
  # }
}

###############################################################################
# Die einzelnen LXC-Container
#
# LXC-Templates haben keine latest-URL. Die aktuell verfuegbaren Dateinamen
# zeigt auf procmox:
#   pveam update && pveam available --section system
# Herunterladen:
#   pveam download local debian-13-standard_13.6-1_amd64.tar.zst
###############################################################################

containers = {
  # Variante A: Template liegt schon auf dem Node
  "tofu-ct" = {
    template_file_id = "local:vztmpl/debian-13-standard_13.6-1_amd64.tar.zst"
    os_type          = "debian"
    vm_id            = 510
    cpu_cores        = 1
    memory           = 512
    disk_size        = 8
    tags             = ["opentofu", "debian", "lxc"]
  }

  # Variante B: OpenTofu laedt das Template selbst (template_catalog unten)
  # "tofu-ct-ubuntu" = {
  #   template  = "ubuntu-24.04"
  #   os_type   = "ubuntu"
  #   vm_id     = 511
  #   memory    = 1024
  #   disk_size = 16
  #
  #   # nesting braucht root@pam - mit einem API-Token lehnt PVE das ab.
  #   # features = { nesting = true }
  # }
}

# Eigene Template-URLs. Version vorher mit `pveam available` pruefen.
# template_catalog = {
#   "ubuntu-24.04" = {
#     url = "http://download.proxmox.com/images/system/ubuntu-24.04-standard_24.04-2_amd64.tar.zst"
#   }
# }

