#cloud-config
hostname: ${jsonencode(hostname)}
manage_etc_hosts: true
preserve_hostname: false

users:
  - name: ${jsonencode(username)}
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: ${password == null ? "true" : "false"}
%{~ if length(ssh_public_keys) > 0 }
    ssh_authorized_keys:
%{~ for key in ssh_public_keys }
      - ${jsonencode(key)}
%{~ endfor }
%{~ endif }

%{~ if password != null }
chpasswd:
  expire: false
  users:
    - name: ${jsonencode(username)}
      password: ${jsonencode(password)}
      type: text
ssh_pwauth: true
%{~ endif }

package_update: true
package_upgrade: ${package_upgrade}
%{~ if length(packages) > 0 }
packages:
%{~ for package in packages }
  - ${jsonencode(package)}
%{~ endfor }
%{~ endif }

%{~ if length(managed_disks) > 0 }
# Zusatzplatten einrichten. `partition: none` legt das Dateisystem direkt auf
# das Geraet, ohne Partitionstabelle - fuer eine reine Datenplatte genuegt das.
# `overwrite: false` ist die Bremse: cloud-init formatiert nur, wenn dort noch
# kein Dateisystem liegt. Ohne das waere ein zweiter Lauf ein Datenverlust.
fs_setup:
%{~ for disk in managed_disks }
  - device: ${jsonencode(disk.device)}
    filesystem: ${jsonencode(disk.filesystem)}
    label: ${jsonencode(disk.label)}
    partition: none
    overwrite: false
%{~ endfor }

# nofail: haengt die Platte nicht ein, wenn sie fehlt, statt den Boot in die
# Notfall-Shell laufen zu lassen.
mounts:
%{~ for disk in managed_disks }
  - [${jsonencode(disk.device)}, ${jsonencode(disk.mount)}, ${jsonencode(disk.filesystem)}, "defaults,nofail", "0", "2"]
%{~ endfor }
%{~ endif }

runcmd:
  - systemctl enable --now qemu-guest-agent || true

final_message: "cloud-init fertig nach $UPTIME Sekunden"
